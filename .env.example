APP_NAME=Open Reclamos
HTTP_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:8080
ALLOW_PUBLIC_REGISTRATION=false

# JWT: access de 10 minutos y refresh con plazo fijo de 24 horas desde el login.
# Sin secretos explícitos, Go crea y conserva las claves en este archivo privado.
JWT_KEY_FILE=./data/jwt-keys.json
# Opcional: claves base64 distintas, cada una de al menos 32 bytes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Base de datos: sqlite (por defecto, un archivo local) o postgres.
# Sin DATABASE_DRIVER se usa postgres si hay DATABASE_URL o DB_*; si no, sqlite.
# Ejecutar migrate (y seed) antes de serve en ambos casos.
DATABASE_DRIVER=
SQLITE_PATH=./data/open-reclamos.db
# PostgreSQL: DATABASE_URL o, como alternativa, todos los campos DB_*.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable

# Solo desarrollo: destino del proxy Vite, nunca se publica al navegador.
DEV_API_TARGET=http://127.0.0.1:8080

# Claves base64 de 32 bytes; necesarias cuando se configura la integración.
SSO_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY=
SSO_ALLOWED_HOSTS=
# Orígenes separados por comas; * acepta cualquier Origin.
ALLOWED_ORIGINS=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/files
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SMTP_ENABLED=false
# Mailpit del compose para desarrollo local; activar SMTP_ENABLED para capturar.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@openreclamos.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_MODE=none

DOCUMENT_LOOKUP_PROVIDER=none
DOCUMENT_LOOKUP_TOKEN=
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
