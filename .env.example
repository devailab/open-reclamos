APP_NAME="Open Reclamos"
FRONTEND_URL="http://localhost:3000"
ALLOW_PUBLIC_REGISTRATION=false
EMAIL_VERIFICATION_ENABLED=false
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="supersecretkey"

# OpenID Connect (when enabled, local email/password access is disabled)
# Register this redirect URI in the provider:
# ${BETTER_AUTH_URL}/api/auth/oauth2/callback/${SSO_PROVIDER_ID}
SSO_ENABLED=false
SSO_PROVIDER_ID="open-reclamos-sso"
SSO_PROVIDER_NAME="SSO corporativo"
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
SSO_DISCOVERY_URL=""
SSO_SCOPES="openid,email,profile"
# Account management page in the identity provider (profile, password, MFA).
# When SSO is enabled, "Administrar cuenta" links here instead of the local page.
SSO_ACCOUNT_URL=""

DB_NAME="open-reclamos"
DB_USER="postgres"
DB_PASSWORD="admin"
DB_HOST="localhost"
DB_PORT="5432"

# Providers: JSON_PE | API_PERU_DEV
DOCUMENT_LOOKUP_PROVIDER="API_PERU_DEV"
DOCUMENT_LOOKUP_API_PERU_DEV_TOKEN=""
DOCUMENT_LOOKUP_API_PERU_DEV_URL="https://apiperu.dev"
# or:
# DOCUMENT_LOOKUP_PROVIDER="JSON_PE"
# DOCUMENT_LOOKUP_JSON_PE_TOKEN=""
# DOCUMENT_LOOKUP_JSON_PE_URL="https://api.json.pe"

# Provider: SMTP
EMAIL_TRANSPORT="SMTP"
EMAIL_FROM_ADDRESS="no-reply@example.com"
EMAIL_FROM_NAME="Open Reclamos"
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER="user@example.com"
EMAIL_SMTP_PASSWORD="password"
EMAIL_SMTP_POOL="false"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_IGNORE_TLS="false"

S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="open-reclamos"

INNGEST_URL="http://127.0.0.1:8288"
INNGEST_APP_ID="open-reclamos"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# INNGEST_DEV=1

TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# generated by `openssl rand -hex 32`
WEBHOOK_SECRET_ENCRYPTION_KEY=""
