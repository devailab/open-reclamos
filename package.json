{
    "name": "open-reclamos",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/web",
        "packages/rpc-client"
    ],
    "scripts": {
        "dev:api": "bun run scripts/dev-api.ts",
        "dev:web": "bun run --cwd apps/web dev",
        "db:migrate": "bun run scripts/database.ts migrate",
        "db:seed": "bun run scripts/database.ts seed",
        "test:web": "bun run --cwd apps/web test",
        "test:api": "go -C apps/api test ./...",
        "generate": "bun run scripts/generate.ts",
        "build": "bun run scripts/build.ts",
        "format": "bun run scripts/format.ts",
        "check": "bun run scripts/check.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@bufbuild/buf": "1.73.0",
        "@bufbuild/protoc-gen-es": "2.16.0",
        "@types/bun": "1.3.14",
        "playwright": "1.63.0",
        "typescript": "6.0.3"
    }
}
